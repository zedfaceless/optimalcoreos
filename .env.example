# Every variable the app reads, and nothing it does not. Copy to `.env.local` and fill in;
# `.env*` is ignored by git except this file. A key left empty is a feature that stays off,
# not a crash: the site still renders, the forms still validate, and the console says it is
# not configured. Which empty key means what is written beside it, and `docs/PLACEHOLDERS.md`
# has the values only the owner can supply.

# --- URLs -----------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used by metadata, canonical links, the sitemap,
# `robots.txt` and every link in an outbound email. A build without it publishes
# http://localhost:3000 into those files (lib/site/config.ts spells out why there is no
# invented production domain).
NEXT_PUBLIC_SITE_URL=

# --- Supabase -------------------------------------------------------------------------
# `supabase start` prints both of these. NEXT_PUBLIC_* are inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_: it bypasses every RLS policy.
# `supabase status` shows it as `service_role key`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) -------------------------------------------------------------------
# Empty means "[email] skipped" in the server log and a saved row nobody was told about.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. The fallback,
# "Optimal Core OS <onboarding@resend.dev>", only delivers to the Resend account owner —
# fine for a smoke test, not for a customer.
EMAIL_FROM=
# Comma-separated inboxes told about every new lead. Empty disables the notification.
OWNER_NOTIFY_EMAIL=

# --- Public contact details (printed on the site and in emails) ------------------------
# The site falls back to hello@optimalcoreos.com. Reply-To is this address.
CONTACT_PUBLIC_EMAIL=
# Optional. Empty renders no phone line at all rather than a fake number.
CONTACT_PUBLIC_PHONE=
# Empty renders a line of copy nobody has confirmed. Keep the timezone if you change it.
CONTACT_PUBLIC_HOURS=

# --- Privacy --------------------------------------------------------------------------
# Salt for the SHA-256 in lib/supabase/admin.ts. The stored value is a hash of the IP, never
# the address; changing the salt makes yesterday's hashes unrecognisable, which is the point
# of a rotation and also the cost of one.
IP_HASH_SALT=
# Months before a lead or message may be deleted, quoted on /privacy. Defaults to 24.
DATA_RETENTION_MONTHS=
# "Last updated" on /privacy and /terms. Empty renders no date rather than a claim about a
# review nobody has done. ISO date, e.g. 2026-11-01.
NEXT_PUBLIC_LEGAL_UPDATED=
